root = true

[*]
charset = utf-8

[*.cs]

# Universal

max_line_length = 100

indent_style = space
indent_size = 4

end_of_line = lf
insert_final_newline = true
charset = utf-8

# Don't knwow

csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped
csharp_wrap_arguments_style = chop_if_long
csharp_wrap_parameters_style = chop_if_long

# Roslyn / analyzers
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.CS8655.severity = none

# CSharpier
csharpier_print_width = 100

# CS8655: The switch expression does not handle some null inputs.
dotnet_diagnostic.CS8655.severity = none

# CS8655: The switch expression does not handle some null inputs.
dotnet_diagnostic.CS8655.severity = none
