[gd_scene format=3]

[ext_resource type="PackedScene" path="res://quest_world/levels/facility_playable_slice.tscn" id="1_base"]

[sub_resource type="Environment" id="Environment_LightmapTest"]
background_mode = 1
background_color = Color(0.004, 0.006, 0.012, 1)
ambient_light_source = 2
ambient_light_color = Color(0.42, 0.48, 0.58, 1)
ambient_light_energy = 0.02
ambient_light_sky_contribution = 0.0
reflected_light_source = 2
tonemap_mode = 1
ssao_enabled = true
ssao_radius = 1.2
ssao_intensity = 1.15
ssao_power = 1.25
ssil_enabled = false
sdfgi_enabled = false

[node name="test_world" instance=ExtResource("1_base")]

; Pure LightmapGI comparison scene.
; This intentionally starts from facility_playable_slice.tscn instead of the
; previous SDFGI lighting pass so the A/B test changes the GI technique rather
; than inheriting the widened real-time spots.
;
; IMPORTANT: LightmapGI cannot bake the CSGBox3D nodes directly. In Godot 4.7,
; bake the CSG geometry to MeshInstance3D and unwrap UV2 before pressing
; "Bake Lightmaps" on the LightmapGI node. Keep the original CSG hidden so the
; source blockout remains editable.

[node name="WorldEnvironment" parent="."]
environment = SubResource("Environment_LightmapTest")

[node name="LightmapGI" type="LightmapGI" parent="."]
quality = 2
bounces = 5
bounce_indirect_energy = 1.0
directional = true
environment_mode = 0
interior = true
generate_probes_subdiv = 3
supersampling = true
supersampling_factor = 2.0
texel_scale = 1.0
use_denoiser = true
use_texture_for_bounces = true

